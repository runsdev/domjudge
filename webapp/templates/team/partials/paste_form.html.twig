{# [problem external ID, statement URL] pairs, falling back to the contest problemset;
   a hash would renumber numeric IDs on merge. navpanes=0 hides the thumbnails of the
   PDF viewer, so the page fits the panel width. In lockdown, teams only get Markdown statements. #}
{% set problemset_url = current_team_contest.contestProblemsetType is not empty and not team_lockdown ? path('team_contest_problemset') ~ '#navpanes=0' : null %}
{% set statement_urls = problemset_url ? [['', problemset_url]] : [] %}
{% for choice in paste_form.problem.vars.choices %}
    {% set statement_type = choice.data.problemstatementType %}
    {% if statement_type == 'md' or (statement_type is not empty and not team_lockdown) %}
        {% set statement_urls = statement_urls | merge([[choice.value, path('team_problem_statement', {probId: choice.value}) ~ (statement_type == 'pdf' ? '#navpanes=0' : '')]]) %}
    {% elseif problemset_url %}
        {% set statement_urls = statement_urls | merge([[choice.value, problemset_url]]) %}
    {% endif %}
{% endfor %}
{{ form_start(paste_form, {'attr': {'class': 'd-flex flex-column flex-fill', 'data-draft-key': 'domjudge-draft/' ~ current_team_contest.externalid ~ '/' ~ app.user.team.externalid ~ '/'}}) }}
<div class="paste-toolbar px-3 py-2 border-bottom d-flex align-items-end gap-3 flex-wrap">
    <div class="paste-toolbar-field">
        <button type="button" class="btn btn-outline-secondary" id="paste-statement-toggle" aria-controls="paste-statement" title="Show or hide the problem statement">
            <i class="fas fa-book-open"></i> Statement
        </button>
    </div>
    <div class="paste-toolbar-field">
        {{ form_label(paste_form.problem) }}
        {{ form_widget(paste_form.problem) }}
    </div>
    <div class="paste-toolbar-field">
        {{ form_label(paste_form.language) }}
        {{ form_widget(paste_form.language) }}
    </div>
    <div class="paste-toolbar-field" data-entry-point-toolbar>
        {{ form_label(paste_form.entry_point) }}
        {{ form_widget(paste_form.entry_point) }}
    </div>
    <div class="paste-toolbar-info align-self-end pb-1">
        <small class="text-muted">
            Filename: <code class="paste-derived-filename" data-form-prefix="submit_problem_paste">-</code>
        </small>
    </div>
    <div class="paste-toolbar-submit align-self-end ms-auto">
        <button type="submit" class="btn btn-success"><i class="fas fa-cloud-upload-alt"></i> Submit</button>
    </div>
</div>
{% include 'team/partials/rate_limit_warning.html.twig' with {'alert_extra_classes': 'mx-3 mt-2 mb-0'} %}
<div class="paste-workspace d-flex flex-fill">
    <div class="paste-statement" id="paste-statement" data-statement-urls="{{ statement_urls | json_encode }}" hidden>
        <iframe title="Problem statement"></iframe>
        <p class="paste-statement-empty text-muted p-3">Select a problem with a statement to show it here.</p>
    </div>
    <div class="paste-editor-container flex-fill">
        {{ '' | codeEditor('paste_page', null, true, paste_form.code_content.vars.id) }}
    </div>
</div>
{{ form_widget(paste_form.code_content) }}
{{ form_end(paste_form) }}
